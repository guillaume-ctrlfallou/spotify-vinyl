<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp">
        <ImageView android:id="@+id/cover" android:layout_width="52dp" android:layout_height="52dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="14sp"
                android:maxLines="1" android:ellipsize="end" android:shadowColor="#AA000000" android:shadowRadius="6" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                android:shadowColor="#AA000000" android:shadowRadius="6" />
        </LinearLayout>
        <ImageButton android:id="@+id/play" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/btn_fill" android:scaleType="centerInside" android:padding="10dp" />
        <ImageButton android:id="@+id/next" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="8dp" android:background="@drawable/btn_outline" android:scaleType="centerInside"
            android:padding="9dp" android:src="@android:drawable/ic_media_next" />
    </LinearLayout>
</FrameLayout>
